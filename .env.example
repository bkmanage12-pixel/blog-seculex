# ==============================================================================
# SecuLex Payment System Environment Variables
# DPO INTEGRATION STATUS: WAITING FOR NETWORK APPROVAL / API CREDENTIALS
# ==============================================================================
# Configure these variables in Netlify Site Settings > Environment Variables
# (or in your local .env file during development - NEVER commit real credentials)

# Integration Environment: TEST or PRODUCTION
DPO_ENVIRONMENT=TEST

# DPO Pay / Network Merchant Credentials (to be provided upon account approval)
DPO_MERCHANT_ID=
DPO_API_KEY=
DPO_SECRET=

# DPO Service Type (Provided in DPO Integration Guide, e.g. 38549 or standard service code)
DPO_SERVICE_TYPE=

# Base Production/Staging URL for Callback and Redirection
SECULEX_BASE_URL=https://seculex.org

# Optional secret for signing/verifying internal payment state tokens
PAYMENT_SIGNING_SECRET=seculex_internal_payment_signature_secret_key_change_in_production
