</main>

<script>
document.addEventListener("DOMContentLoaded", async () => {
  const urlParams = new URLSearchParams(window.location.search);
  const ref = urlParams.get("ref") || urlParams.get("reference") || "";
  const token = urlParams.get("token") || "";
  const outcome = urlParams.get("outcome") || "";

  const cardLoading = document.getElementById("status-card-loading");
  const cardPaid = document.getElementById("status-card-paid");
  const cardPending = document.getElementById("status-card-pending");
  const cardFailed = document.getElementById("status-card-failed");

  const btnRecheck = document.getElementById("btn-recheck-status");

  function hideAllCards() {
    cardLoading.style.display = "none";
    cardPaid.style.display = "none";
    cardPending.style.display = "none";
    cardFailed.style.display = "none";
  }

  function formatPrice(amount, curr) {
    if (!amount) return "N/A";
    if (curr === "RWF") {
      return Number(amount).toLocaleString("en-US") + " RWF";
    }
    return (curr || "USD") + " " + Number(amount).toFixed(2);
  }

  async function verifyPayment() {
    hideAllCards();
    cardLoading.style.display = "block";

    if (!ref) {
      hideAllCards();
      cardFailed.style.display = "block";
      document.getElementById("failed-error-msg").textContent = "No transaction reference was provided in the URL.";
      document.getElementById("failed-ref").textContent = "N/A";
      return;
    }

    // Retrieve saved stateToken from session storage if available
    const savedState = sessionStorage.getItem("seculex_payment_token_" + ref) || "";

    try {
      const queryUrl = "/.netlify/functions/verify-payment?ref=" + encodeURIComponent(ref) +
        (token ? "&token=" + encodeURIComponent(token) : "") +
        (savedState ? "&state=" + encodeURIComponent(savedState) : "") +
        (outcome ? "&outcome=" + encodeURIComponent(outcome) : "");

      const res = await fetch(queryUrl);
      const data = await res.json();

      hideAllCards();

      if (!res.ok || !data.success) {
        cardFailed.style.display = "block";
        document.getElementById("failed-error-msg").textContent = data.error || "Transaction verification failed.";
        document.getElementById("failed-ref").textContent = ref;
        return;
      }

      const tx = data.transaction || {};

      if (data.status === "PAID" || tx.status === "PAID") {
        cardPaid.style.display = "block";
        document.getElementById("paid-ref").textContent = tx.reference || ref;
        document.getElementById("paid-service").textContent = tx.serviceName || "SecuLex Professional Consultation";
        document.getElementById("paid-client-name").textContent = tx.customerName || "Verified Client";
        document.getElementById("paid-client-email").textContent = tx.customerEmail || "N/A";
        document.getElementById("paid-timestamp").textContent = tx.paid_at ? new Date(tx.paid_at).toLocaleString() : new Date().toLocaleString();
        document.getElementById("paid-gateway").textContent = tx.gateway || "DPO Pay / Network";
        document.getElementById("paid-amount").textContent = formatPrice(tx.amount, tx.currency);
      } else if (data.status === "PENDING" || tx.status === "PENDING" || tx.status === "PROCESSING") {
        cardPending.style.display = "block";
        document.getElementById("pending-ref").textContent = ref;
      } else {
        cardFailed.style.display = "block";
        document.getElementById("failed-error-msg").textContent = "Transaction status: " + (data.status || "FAILED") + ". Please try again or contact support.";
        document.getElementById("failed-ref").textContent = ref;
      }

    } catch (err) {
      console.error("Verification error:", err);
      hideAllCards();
      cardFailed.style.display = "block";
      document.getElementById("failed-error-msg").textContent = "Unable to connect to the verification server. Please try refreshing.";
      document.getElementById("failed-ref").textContent = ref;
    }
  }

  if (btnRecheck) {
    btnRecheck.addEventListener("click", () => {
      verifyPayment();
    });
  }

  // Execute verification
  verifyPayment();
});
</script>
