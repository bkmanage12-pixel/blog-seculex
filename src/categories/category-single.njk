---
layout: base.njk
pagination:
  data: categories
  size: 1
  alias: catKey
permalink: "/categories/{{ catKey }}/index.html"
eleventyComputed:
  title: "{{ categories[catKey].title }} | SecuLex Categories"
---

{% set cat = categories[catKey] %}
{% set catPosts = collections.posts | filterByCategory(cat.title) | reverse %}

<div class="page-header-section fade-in">
    <div class="page-header-inner">
        <div class="page-header-icon page-header-icon--{{ cat.color_class }}">
            <i class="fas {{ cat.icon }}"></i>
        </div>
        <h1>{{ cat.title }}</h1>
        <p>{{ catPosts.length }} {% if catPosts.length == 1 %}{{ categories_page.article_singular | default("article") }}{% else %}{{ categories_page.article_plural | default("articles") }}{% endif %} {{ categories_page.single_category_suffix }} {{ cat.title }}</p>
    </div>
</div>

<main class="categories-main">
    {% if catPosts.length > 0 %}
    <div class="cat-grid fade-in" style="max-width:1280px;margin:0 auto;">
        {% for post in catPosts %}
        <article class="cat-card">
            <a href="{{ post.url }}" class="cat-card-img-link">
                <img src="{{ post.data.thumbnail }}" alt="{{ post.data.title }}" loading="lazy">
                <div class="cat-card-overlay"><span>{{ categories_page.read_label | default("Read") }}</span></div>
            </a>
            <div class="cat-card-body">
                <span class="cat-badge cat-badge--{{ cat.color_class }}">{{ cat.title }}</span>
                <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
                <p>{{ post.data.description | truncate(110) }}</p>
                <div class="cat-card-meta">
                    <span><i class="far fa-clock"></i> {{ post.data.read_time }} {{ articles_page.min_read_label | default("min read") }}</span>
                    <a href="{{ post.url }}" class="cat-read-link">{{ categories_page.read_label | default("Read") }} <i class="fas fa-arrow-right"></i></a>
                </div>
            </div>
        </article>
        {% endfor %}
    </div>
    {% else %}
    <p class="no-posts-msg"><i class="fas fa-folder-open"></i> {{ categories_page.no_posts_label | default("No articles in this category yet.") }}</p>
    {% endif %}
</main>
