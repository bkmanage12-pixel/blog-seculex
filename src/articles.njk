---
layout: base.njk
title: Scholarly Publications | SecuLex
pagination:
  data: collections.posts
  size: 6
  reverse: true
  alias: posts
permalink: "articles/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}index.html"
---

<div class="articles-hub-header fade-in">
    <div class="articles-hub-inner">

        <!-- Top bar: Badge + Title + Search -->
        <div class="hub-topbar">
            <div class="hub-identity">
                <h1 class="hub-title">{{ articles_page.page_title | default("All Publications") }}</h1>
            </div>
            <div class="hub-search-col">
                <div class="repo-search-box">
                    <i class="fas fa-search repo-search-icon"></i>
                    <input type="text" id="article-search" placeholder="{{ articles_page.search_placeholder | default('Search title, topic or keyword...') }}" autocomplete="off">
                    <button type="button" id="search-clear" class="repo-search-clear" aria-label="Clear search"><i class="fas fa-times"></i></button>
                </div>
            </div>
        </div>

        <!-- Unified Filter Row -->
        <div class="hub-filter-bar">
            <div class="filter-section">
                <span class="filter-label"><i class="fas fa-layer-group"></i> {{ articles_page.filter_theme_label | default("Theme") }}</span>
                <div class="filter-pills-row" id="theme-pills-row">
                    <button type="button" class="repo-pill repo-theme-pill active" data-theme="all">{{ articles_page.filter_theme_all_label | default("All") }}</button>
                    {% for key, cat in categories %}
                    <button type="button" class="repo-pill repo-theme-pill" data-theme="{{ cat.title }}">
                        {{ cat.title }}
                    </button>
                    {% endfor %}
                </div>
            </div>
            <div class="filter-divider"></div>
            <div class="filter-section">
                <span class="filter-label"><i class="far fa-calendar-alt"></i> {{ articles_page.filter_year_label | default("Year") }}</span>
                <div class="filter-pills-row" id="year-filter-buttons">
                    <button type="button" class="repo-pill repo-year-pill active" data-year="all">{{ articles_page.filter_year_all_label | default("All") }}</button>
                </div>
            </div>
        </div>

        <!-- Status Bar -->
        <div class="repo-status-bar" id="repo-status-bar">
            <div class="repo-count-wrapper">
                <span class="pulse-dot"></span>
                <span id="results-count-text">{{ articles_page.results_count_all_label | default("Showing all publications") }}</span>
            </div>
            <div id="filter-status-indicator" class="active-filters-wrapper" style="display: none;">
                <span class="active-filters-label">{{ articles_page.active_filter_prefix | default("Active filters:") }}</span>
                <span id="active-filter-text" class="active-filters-tags"></span>
                <button type="button" id="reset-all-filters-btn" class="reset-filters-btn"><i class="fas fa-undo-alt"></i> {{ articles_page.reset_filter_button_label | default("Reset") }}</button>
            </div>
        </div>

    </div>
</div>

<main class="articles-main-wrapper">
    <!-- Default Paginated View (shown on load before filtering/searching) -->
    <div id="default-articles-section">
        <div class="blog-grid fade-in">
            {% for post in posts %}
            <article class="blog-card">
                <div class="card-img">
                    <a href="{{ post.url }}">
                        <img src="{{ post.data.thumbnail }}" alt="{{ post.data.title }}" loading="lazy">
                        <div class="card-overlay">
                            <span><i class="fas fa-book-open"></i> {{ articles_page.read_label | default("Read Analysis") }}</span>
                        </div>
                    </a>
                    <span class="card-category-badge">{{ post.data.category }}</span>
                </div>
                <div class="card-content">
                    <div class="meta">
                        <span class="category"><i class="fas fa-folder-open"></i> {{ post.data.category }}</span>
                        <span class="date"><i class="far fa-calendar-alt"></i> {{ post.data.date | readableDate }}</span>
                    </div>
                    <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
                    <p>{{ post.data.description | truncate(135) }}</p>
                    <div class="card-footer">
                        {% if post.data.read_time %}<span class="read-time"><i class="far fa-clock"></i> {{ post.data.read_time }} {{ articles_page.min_read_label | default("min read") }}</span>{% endif %}
                        <a href="{{ post.url }}" class="read-more">{{ articles_page.read_label | default("Read Analysis") }} <i class="fas fa-arrow-right"></i></a>
                    </div>
                </div>
            </article>
            {% endfor %}
        </div>

        <!-- Pagination Controls -->
        <div class="pagination-container">
            {% if pagination.href.previous %}
                <a href="{{ pagination.href.previous }}" class="btn btn-outline"><i class="fas fa-arrow-left"></i> {{ articles_page.previous_label | default("Previous") }}</a>
            {% else %}
                <span class="btn btn-disabled"><i class="fas fa-arrow-left"></i> {{ articles_page.previous_label | default("Previous") }}</span>
            {% endif %}

            <span class="pagination-status">
                {{ articles_page.page_status_label | default("Page") }} {{ pagination.pageNumber + 1 }} {{ articles_page.page_status_connector | default("of") }} {{ pagination.pages.length }}
            </span>

            {% if pagination.href.next %}
                <a href="{{ pagination.href.next }}" class="btn btn-outline">{{ articles_page.next_label | default("Next") }} <i class="fas fa-arrow-right"></i></a>
            {% else %}
                <span class="btn btn-disabled">{{ articles_page.next_label | default("Next") }} <i class="fas fa-arrow-right"></i></span>
            {% endif %}
        </div>
    </div>

    <!-- Filter & Search Results Section (Rendered dynamically when active) -->
    <div id="search-results-section" style="display: none;">
        <div class="blog-grid" id="search-results-grid"></div>
        <div id="search-no-results" class="repo-no-results" style="display: none;">
            <div class="no-results-icon"><i class="fas fa-search"></i></div>
            <h3>{{ articles_page.no_results_title | default("No Publications Found") }}</h3>
            <p>{{ articles_page.no_results_label | default("We could not find any publications matching your selected criteria. Try adjusting your theme, year, or search terms.") }}</p>
            <button type="button" id="no-results-reset-btn" class="btn btn-pill-solid" style="margin-top: 1.25rem;">
                <i class="fas fa-layer-group"></i> {{ articles_page.no_results_reset_label | default("View All Publications") }}
            </button>
        </div>
    </div>
</main>

<style>
/* ================================================
   Articles Hub Header — Compact Command Bar Layout
   ================================================ */
.articles-hub-header {
  padding: 1.75rem 1.5rem 0;
  background: linear-gradient(180deg, #07090f 0%, #080c15 100%);
  border-bottom: 1px solid rgba(212, 175, 55, 0.12);
  position: relative;
}

.articles-hub-inner {
  max-width: 1200px;
  margin: 0 auto;
}

/* Top bar: identity left, search right */
.hub-topbar {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  margin-bottom: 1.25rem;
}

.hub-identity {
  flex: 0 0 auto;
}



.hub-title {
  font-family: var(--font-serif);
  font-size: clamp(1.35rem, 2.2vw, 1.85rem);
  color: #ffffff;
  font-weight: 700;
  letter-spacing: -0.2px;
  margin: 0;
  line-height: 1.15;
}

.hub-search-col {
  flex: 1 1 0;
  max-width: 520px;
  margin-left: auto;
}

.repo-search-box {
  position: relative;
}

.repo-search-icon {
  position: absolute;
  left: 1rem;
  top: 50%;
  transform: translateY(-50%);
  color: var(--accent-gold);
  font-size: 0.9rem;
  pointer-events: none;
}

.repo-search-box input {
  width: 100%;
  padding: 0.7rem 2.6rem 0.7rem 2.6rem;
  border-radius: 10px;
  border: 1px solid rgba(212, 175, 55, 0.22);
  background: rgba(255, 255, 255, 0.04);
  color: #ffffff;
  font-size: 0.9rem;
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
  box-sizing: border-box;
}

.repo-search-box input::placeholder {
  color: rgba(255, 255, 255, 0.3);
}

.repo-search-box input:focus {
  border-color: rgba(212, 175, 55, 0.55);
  box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.1);
}

.repo-search-clear {
  position: absolute;
  right: 0.8rem;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255, 255, 255, 0.08);
  border: none;
  color: var(--text-secondary);
  border-radius: 50%;
  width: 22px;
  height: 22px;
  display: none;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  font-size: 0.75rem;
  transition: all 0.2s ease;
  padding: 0;
}

.repo-search-clear:hover {
  background: #ef4444;
  color: #ffffff;
}

/* ── Unified filter bar ── */
.hub-filter-bar {
  display: flex;
  align-items: center;
  gap: 0;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  padding: 0.75rem 0;
  overflow-x: auto;
  scrollbar-width: none;
}

.hub-filter-bar::-webkit-scrollbar { display: none; }

.filter-section {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-shrink: 0;
}

.filter-label {
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  color: rgba(212, 175, 55, 0.7);
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: 0.3rem;
  padding-right: 0.4rem;
}

.filter-divider {
  width: 1px;
  height: 24px;
  background: rgba(255, 255, 255, 0.1);
  margin: 0 0.75rem;
  flex-shrink: 0;
}

.filter-pills-row {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  flex-wrap: nowrap;
  overflow-x: auto;
  scrollbar-width: none;
}

.filter-pills-row::-webkit-scrollbar { display: none; }

.repo-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.3rem 0.75rem;
  border-radius: 6px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.04);
  color: rgba(255, 255, 255, 0.65);
  font-size: 0.78rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.18s ease;
  white-space: nowrap;
  letter-spacing: 0.2px;
  user-select: none;
}

.repo-pill:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(212, 175, 55, 0.35);
  color: #ffffff;
}

.repo-pill.active {
  background: var(--accent-gold);
  color: #05080f;
  border-color: var(--accent-gold);
  font-weight: 700;
  box-shadow: 0 2px 10px rgba(212, 175, 55, 0.3);
}

/* Status Bar */
.repo-status-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 0.55rem 0 0.65rem;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  font-size: 0.8rem;
}

.repo-count-wrapper {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  color: rgba(255, 255, 255, 0.45);
  font-weight: 500;
}

.pulse-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent-gold);
  box-shadow: 0 0 6px var(--accent-gold);
  flex-shrink: 0;
}

.active-filters-wrapper {
  display: flex;
  align-items: center;
  gap: 0.45rem;
}

.active-filters-label {
  color: rgba(255, 255, 255, 0.4);
  font-size: 0.76rem;
}

.active-filters-tags {
  color: var(--accent-gold);
  font-weight: 600;
  font-size: 0.78rem;
}

.reset-filters-btn {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.7);
  font-size: 0.72rem;
  font-weight: 600;
  padding: 0.2rem 0.55rem;
  border-radius: 5px;
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
}

.reset-filters-btn:hover {
  background: rgba(239, 68, 68, 0.15);
  border-color: #ef4444;
  color: #ef4444;
}

/* Main Articles Grid Layout */
.articles-main-wrapper {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2.5rem 1.5rem 4rem;
}

.repo-no-results {
  text-align: center;
  padding: 3.5rem 1.5rem;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 16px;
  margin: 2rem 0;
}

.no-results-icon {
  width: 54px;
  height: 54px;
  border-radius: 50%;
  background: rgba(212, 175, 55, 0.1);
  color: var(--accent-gold);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.4rem;
  margin: 0 auto 1.1rem;
}

.repo-no-results h3 {
  font-family: var(--font-serif);
  font-size: 1.4rem;
  color: #ffffff;
  margin-bottom: 0.45rem;
}

.repo-no-results p {
  color: var(--text-secondary);
  max-width: 440px;
  margin: 0 auto;
  font-size: 0.92rem;
}

/* Responsive */
@media (max-width: 768px) {
  .hub-topbar {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    margin-bottom: 0;
  }
  .hub-search-col {
    width: 100%;
    max-width: 100%;
    margin-left: 0;
  }
  .hub-filter-bar {
    gap: 0;
  }
  .filter-divider {
    margin: 0 0.5rem;
  }
  .repo-status-bar {
    flex-direction: column;
    align-items: flex-start;
  }
}
</style>

<script>
    const readLabel = {{ articles_page.read_label | default("Read Analysis") | dump | safe }};
    const minReadLabel = {{ articles_page.min_read_label | default("min read") | dump | safe }};
    const countAllLabel = {{ articles_page.results_count_all_label | default("Showing all publications") | dump | safe }};
    const countFilteredLabel = {{ articles_page.results_count_filtered_label | default("publications found") | dump | safe }};

    const ALL_POSTS = [
        {% for post in collections.posts %}
        {
            title: {{ post.data.title | dump | safe }},
            url: {{ post.url | dump | safe }},
            category: {{ post.data.category | dump | safe }},
            author: {{ post.data.author | default("SecuLex Editorial") | dump | safe }},
            description: {{ post.data.description | default("") | dump | safe }},
            thumbnail: {{ post.data.thumbnail | default("/assets/images/default-post.png") | dump | safe }},
            readTime: {{ post.data.read_time | default(5) | dump | safe }},
            date: {{ post.data.date | readableDate | dump | safe }},
            year: "{{ post.date.getFullYear() }}",
            paywallEnabled: {{ post.data.paywall_enabled | default(false) | dump | safe }},
            price: {{ post.data.price_override | default(paywall.price) | dump | safe }},
            currency: {{ paywall.currency | dump | safe }}
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ];

    document.addEventListener("DOMContentLoaded", () => {
        const searchInput = document.getElementById("article-search");
        const clearBtn = document.getElementById("search-clear");
        const defaultSection = document.getElementById("default-articles-section");
        const resultsSection = document.getElementById("search-results-section");
        const resultsGrid = document.getElementById("search-results-grid");
        const noResultsMsg = document.getElementById("search-no-results");
        const countText = document.getElementById("results-count-text");
        const statusIndicator = document.getElementById("filter-status-indicator");
        const activeFilterText = document.getElementById("active-filter-text");
        const resetBtn = document.getElementById("reset-all-filters-btn");
        const noResultsResetBtn = document.getElementById("no-results-reset-btn");
        const yearButtonsContainer = document.getElementById("year-filter-buttons");

        const themeBtns = document.querySelectorAll(".repo-theme-pill");

        let currentTheme = "all";
        let currentYear = "all";

        // Extract deduplicated publication years
        const uniqueYears = Array.from(
            new Set(
                ALL_POSTS
                    .map(p => {
                        if (p.year && p.year.length === 4 && !isNaN(p.year)) return p.year;
                        const match = (p.date || '').match(/\b(20\d\d)\b/);
                        return match ? match[1] : null;
                    })
                    .filter(Boolean)
            )
        ).sort((a, b) => Number(b) - Number(a));

        // Inject unique year buttons
        if (yearButtonsContainer && uniqueYears.length > 0) {
            uniqueYears.forEach(yr => {
                const btn = document.createElement("button");
                btn.type = "button";
                btn.className = "repo-pill repo-year-pill";
                btn.setAttribute("data-year", yr);
                btn.textContent = yr;
                yearButtonsContainer.appendChild(btn);
            });
        }

        // Read URL params if present
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has("theme")) {
            currentTheme = urlParams.get("theme");
            themeBtns.forEach(btn => {
                btn.classList.toggle("active", btn.getAttribute("data-theme").toLowerCase() === currentTheme.toLowerCase());
            });
        }
        if (urlParams.has("year")) {
            currentYear = urlParams.get("year");
            const allYrBtns = yearButtonsContainer ? yearButtonsContainer.querySelectorAll(".repo-year-pill") : [];
            allYrBtns.forEach(btn => {
                btn.classList.toggle("active", btn.getAttribute("data-year") === currentYear);
            });
        }

        const renderResults = (posts) => {
            resultsGrid.innerHTML = "";
            if (posts.length === 0) {
                noResultsMsg.style.display = "block";
                countText.textContent = `0 ${countFilteredLabel}`;
                return;
            }
            noResultsMsg.style.display = "none";
            countText.textContent = `${posts.length} ${countFilteredLabel}`;

            posts.forEach(post => {
                const cardHtml = `
                    <article class="blog-card fade-in visible" style="opacity: 1; transform: translateY(0);">
                        <div class="card-img">
                            <a href="${post.url}">
                                <img src="${post.thumbnail}" alt="${post.title}" loading="lazy">
                                <div class="card-overlay">
                                    <span><i class="fas fa-book-open"></i> ${readLabel}</span>
                                </div>
                            </a>
                            <span class="card-category-badge">${post.category}</span>
                        </div>
                        <div class="card-content">
                            <div class="meta">
                                <span class="category"><i class="fas fa-folder-open"></i> ${post.category}</span>
                                <span class="date"><i class="far fa-calendar-alt"></i> ${post.date}</span>
                            </div>
                            <h3><a href="${post.url}">${post.title}</a></h3>
                            <p>${post.description.length > 135 ? post.description.substring(0, 135) + '...' : post.description}</p>
                            <div class="card-footer">
                                <span class="read-time"><i class="far fa-clock"></i> ${post.readTime} ${minReadLabel}</span>
                                <a href="${post.url}" class="read-more">${readLabel} <i class="fas fa-arrow-right"></i></a>
                            </div>
                        </div>
                    </article>
                `;
                resultsGrid.insertAdjacentHTML("beforeend", cardHtml);
            });
        };

        const applyAllFilters = () => {
            const query = searchInput.value.trim().toLowerCase();
            const isFiltering = query !== "" || currentTheme !== "all" || currentYear !== "all";

            if (!isFiltering) {
                clearBtn.style.display = "none";
                defaultSection.style.display = "block";
                resultsSection.style.display = "none";
                statusIndicator.style.display = "none";
                countText.textContent = countAllLabel;
                return;
            }

            clearBtn.style.display = query !== "" ? "flex" : "none";
            defaultSection.style.display = "none";
            resultsSection.style.display = "block";
            statusIndicator.style.display = "flex";

            let filterDescriptions = [];
            if (currentTheme !== "all") filterDescriptions.push(`Theme: ${currentTheme}`);
            if (currentYear !== "all") filterDescriptions.push(`Year: ${currentYear}`);
            if (query !== "") filterDescriptions.push(`"${query}"`);
            activeFilterText.textContent = filterDescriptions.join(" • ");

            const filtered = ALL_POSTS.filter(post => {
                const matchesTheme = currentTheme === "all" || 
                    post.category.toLowerCase() === currentTheme.toLowerCase();
                
                const matchesYear = currentYear === "all" || 
                    post.year === currentYear;

                const matchesQuery = query === "" || 
                    post.title.toLowerCase().includes(query) || 
                    post.author.toLowerCase().includes(query) ||
                    post.category.toLowerCase().includes(query) ||
                    post.description.toLowerCase().includes(query);

                return matchesTheme && matchesYear && matchesQuery;
            });

            renderResults(filtered);
        };

        // Theme filter buttons
        themeBtns.forEach(btn => {
            btn.addEventListener("click", () => {
                themeBtns.forEach(b => b.classList.remove("active"));
                btn.classList.add("active");
                currentTheme = btn.getAttribute("data-theme");
                applyAllFilters();
            });
        });

        // Year filter buttons (event delegation)
        if (yearButtonsContainer) {
            yearButtonsContainer.addEventListener("click", (e) => {
                const btn = e.target.closest(".repo-year-pill");
                if (!btn) return;
                const allYrBtns = yearButtonsContainer.querySelectorAll(".repo-year-pill");
                allYrBtns.forEach(b => b.classList.remove("active"));
                btn.classList.add("active");
                currentYear = btn.getAttribute("data-year");
                applyAllFilters();
            });
        }

        searchInput.addEventListener("input", applyAllFilters);

        clearBtn.addEventListener("click", () => {
            searchInput.value = "";
            applyAllFilters();
            searchInput.focus();
        });

        const resetAll = () => {
            currentTheme = "all";
            currentYear = "all";
            searchInput.value = "";
            themeBtns.forEach(b => b.classList.toggle("active", b.getAttribute("data-theme") === "all"));
            if (yearButtonsContainer) {
                const allYrBtns = yearButtonsContainer.querySelectorAll(".repo-year-pill");
                allYrBtns.forEach(b => b.classList.toggle("active", b.getAttribute("data-year") === "all"));
            }
            applyAllFilters();
        };

        if (resetBtn) resetBtn.addEventListener("click", resetAll);
        if (noResultsResetBtn) noResultsResetBtn.addEventListener("click", resetAll);

        if (currentTheme !== "all" || currentYear !== "all") {
            applyAllFilters();
        }
    });
</script>
