---
layout: base.njk
title: Home | SecuLex
---

<section class="hero">
    <div class="hero-bg">
        <img src="{{ home.hero_image }}" alt="Hero Background">
    </div>

    <!-- Animated ambient particles -->
    <div class="hero-particles" aria-hidden="true">
        <span class="hero-particle"></span>
        <span class="hero-particle"></span>
        <span class="hero-particle"></span>
        <span class="hero-particle"></span>
    </div>

    <div class="hero-content fade-in">
        <h1 class="hero-title-split">
            <span class="hero-title-main">{{ home.hero_title | default("Principled Commentary") }}</span> <span class="text-gold hero-accent-line">{{ home.hero_title_accent | default("on Contemporary Law") }}</span>
        </h1>

        <p class="hero-description">{{ home.hero_description }}</p>

        <div class="hero-actions">
            <a href="/articles/" class="btn btn-pill-solid hero-btn-primary" id="explore-articles-btn">
                <i class="fas fa-book-open"></i>
                {{ home.hero_button_text | default("Explore Articles") }}
                <i class="fas fa-arrow-right hero-btn-chevron"></i>
            </a>
            <a href="#about" class="btn hero-btn-ghost">
                <i class="fas fa-info-circle"></i>
                {{ home.hero_secondary_button_text | default("About the Journal") }}
            </a>
        </div>

        <!-- Credibility stats bar -->
        <div class="hero-stats">
            <div class="hero-stat">
                <span class="hero-stat-value">{{ collections.posts | length }}</span>
                <span class="hero-stat-label">{{ home.stat_publications_label | default("Publications") }}</span>
            </div>
            <div class="hero-stat-divider"></div>
            <div class="hero-stat">
                <span class="hero-stat-value">{{ home.stat_peer_reviewed_icon | default("⚖️") }}</span>
                <span class="hero-stat-label">{{ home.stat_peer_reviewed_label | default("Peer Reviewed") }}</span>
            </div>
            <div class="hero-stat-divider"></div>
            <div class="hero-stat">
                <span class="hero-stat-value">{{ home.stat_open_access_icon | default("🌐") }}</span>
                <span class="hero-stat-label">{{ home.stat_open_access_label | default("Open Access") }}</span>
            </div>
        </div>
    </div>

    <div class="hero-scroll-indicator">
        <span></span>
    </div>
</section>

<!-- About SecuLex Section -->
<section id="about" class="about-section fade-in"{% if about.background_image %} style="--about-bg-image: url('{{ about.background_image }}');"{% endif %}>
    <div class="about-inner">
        <div class="about-badge">
            {% if about.profile_photo %}
            <img src="{{ about.profile_photo }}" alt="{{ about.title }}" class="about-profile-img">
            {% else %}
            <i class="fas fa-balance-scale"></i>
            {% endif %}
        </div>
        <div class="about-text">
            <span class="section-tag"><i class="fas fa-shield-alt"></i> {{ about.section_tag | default("About SecuLex") }}</span>
            <h2>{{ about.title | replace("SecuLex", "Secu<span class='text-gold'>Lex</span>") | safe }}</h2>
            {% if about.subtitle %}
            <h3 class="about-subtitle">{{ about.subtitle }}</h3>
            {% endif %}
            
            <p class="about-lead">
                <i class="fas fa-quote-left about-quote-icon"></i>
                {{ about.lead_text | default(about.quote) }}
            </p>

            {% if about.paragraphs %}
                {% for p in about.paragraphs %}
                <p class="about-body-paragraph">{{ p | safe }}</p>
                {% endfor %}
            {% elif about.body_text %}
                <p class="about-body-paragraph">{{ about.body_text }}</p>
            {% endif %}

        </div>

        <!-- Full-Width Pillars Grid across the About Card -->
        <div class="about-pillars-wrapper">
            <div class="about-pillars-header">
                <span class="pillars-header-tag"><i class="fas fa-layer-group"></i> Core Focus Domains</span>
            </div>
            <div class="about-pillars">
                {% for pillar in about.pillars %}
                <div class="pillar" title="{{ pillar.text }}">
                    <div class="pillar-icon-box">
                        <span class="pillar-emoji">{{ pillar.emoji }}</span>
                    </div>
                    <span class="pillar-text">{{ pillar.text }}</span>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- Our Purpose, Our Vision, Our Mission Grid (Landscape Layout) -->
    <div class="about-pvm-container">
        <div class="about-pvm-grid">
            <!-- Our Purpose Card -->
            <div id="purpose" class="pvm-card pvm-card--purpose fade-in">
                <div class="pvm-card-left">
                    <div class="pvm-icon-wrapper pvm-icon--gold">
                        <i class="fas fa-bullseye"></i>
                    </div>
                    <span class="pvm-card-tag">Core Objective</span>
                    <h3>{{ about.purpose.title | default("Our Purpose") }}</h3>
                    <div class="pvm-card-badge-wrap">
                        <span class="pvm-badge"><i class="fas fa-book-reader"></i> Public Education & Sharing</span>
                    </div>
                </div>
                <div class="pvm-card-right">
                    <p class="pvm-lead-text">{{ about.purpose.lead_text }}</p>
                    <p class="pvm-body-text">{{ about.purpose.body_text | replace("digital society, the relationship between technology and law has become impossible to ignore.", "<strong>digital society, the relationship between technology and law has become impossible to ignore.</strong>") | safe }}</p>
                </div>
            </div>

            <!-- Our Vision Card -->
            <div id="vision" class="pvm-card pvm-card--vision fade-in">
                <div class="pvm-card-left">
                    <div class="pvm-icon-wrapper pvm-icon--blue">
                        <i class="fas fa-eye"></i>
                    </div>
                    <span class="pvm-card-tag">Aspiration</span>
                    <h3>{{ about.vision.title | default("Our Vision") }}</h3>
                    <div class="pvm-card-badge-wrap">
                        <span class="pvm-badge pvm-badge--blue"><i class="fas fa-compass"></i> Trusted Knowledge Platform</span>
                    </div>
                </div>
                <div class="pvm-card-right">
                    <p class="pvm-body-text pvm-highlight-text">{{ about.vision.body_text }}</p>
                </div>
            </div>

            <!-- Our Mission Card -->
            <div id="mission" class="pvm-card pvm-card--mission fade-in">
                <div class="pvm-card-left">
                    <div class="pvm-icon-wrapper pvm-icon--purple">
                        <i class="fas fa-rocket"></i>
                    </div>
                    <span class="pvm-card-tag">Commitment</span>
                    <h3>{{ about.mission.title | default("Our Mission") }}</h3>
                    <div class="pvm-card-badge-wrap">
                        <span class="pvm-badge pvm-badge--purple"><i class="fas fa-pen-nib"></i> Credible & Practical Insights</span>
                    </div>
                </div>
                <div class="pvm-card-right">
                    <p class="pvm-body-text pvm-highlight-text">{{ about.mission.body_text }}</p>
                </div>
            </div>
        </div>

        {% if about.motto %}
        <!-- Closing Executive Motto Banner -->
        <div class="about-motto-banner fade-in">
            <div class="motto-logo-wrapper">
                <img src="{{ site.logo_image | default('/assets/images/seculex-shield.png') }}" alt="{{ site.site_title | default('SecuLex') }} Logo" class="motto-logo-img">
            </div>
            <p class="motto-text">“{{ about.motto }}”</p>
            <div class="motto-accent-line"></div>
        </div>
        {% endif %}
    </div>
</section>

<main id="articles">
    <div class="section-header fade-in">
        <div class="section-header-badge">
            <i class="fas fa-scroll"></i>
            {{ home.publications_tag }}
        </div>
        <h2>{{ home.publications_title }}</h2>
        <p>{{ home.publications_description }}</p>
        <div class="section-header-line"></div>
    </div>

    <div class="blog-grid fade-in">
        {% set recent_posts = collections.posts | reverse %}
        {% for post in recent_posts %}
        {% if loop.index0 < 3 %}
        <article class="blog-card">
            <div class="card-img">
                <a href="{{ post.url }}">
                    <img src="{{ post.data.thumbnail }}" alt="{{ post.data.title }}" loading="lazy">
                    <div class="card-overlay">
                        <span><i class="fas fa-book-open" style="margin-right:0.4rem;"></i>{{ articles_page.read_label | default("Read Analysis") }}</span>
                    </div>
                </a>
                <span class="card-category-badge">{{ post.data.category }}</span>
            </div>
            <div class="card-content">
                <div class="meta">
                    <span class="date"><i class="far fa-calendar-alt" style="margin-right:0.3rem;opacity:0.6;"></i>{{ post.data.date | readableDate }}</span>
                    {% if post.data.read_time %}<span class="read-time"><i class="far fa-clock"></i> {{ post.data.read_time }} {{ articles_page.min_read_label | default("min read") }}</span>{% endif %}
                </div>
                <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
                <p>{{ post.data.description | truncate(130) }}</p>
                <div class="card-footer">
                    <a href="{{ post.url }}" class="read-more">{{ articles_page.read_label | default("Read Analysis") }} <i class="fas fa-arrow-right"></i></a>
                    {% if post.data.paywall_enabled %}<span class="card-paid-badge"><i class="fas fa-lock"></i> {{ home.card_premium_badge_label | default("Premium") }}</span>{% else %}<span class="card-free-badge"><i class="fas fa-unlock"></i> {{ home.card_open_badge_label | default("Open") }}</span>{% endif %}
                </div>
            </div>
        </article>
        {% endif %}
        {% endfor %}
    </div>

    <div class="view-all-container fade-in">
        <a href="/articles/" class="btn-view-all">
            <i class="fas fa-layer-group"></i>
            {{ home.view_all_label | default("View All Publications") }}
            <i class="fas fa-arrow-right btn-view-all-arrow"></i>
        </a>
    </div>
</main>
