---
layout: base.njk
title: Home | SecuLex
---

<section class="hero">
    <div class="hero-bg">
        <img src="{{ home.hero_image }}" alt="Hero Background">
    </div>

    <!-- Animated ambient particles -->
    <div class="hero-particles" aria-hidden="true">
        <span class="hero-particle"></span>
        <span class="hero-particle"></span>
        <span class="hero-particle"></span>
        <span class="hero-particle"></span>
    </div>

    <div class="hero-content fade-in">
        <h1 class="hero-title-split">
            <span class="hero-title-main">{{ home.hero_title | default("Principled Commentary") }}</span> <span class="text-gold hero-accent-line">{{ home.hero_title_accent | default("on Contemporary Law") }}</span>
        </h1>

        <p class="hero-description">{{ home.hero_description }}</p>

        <div class="hero-actions">
            <div class="hero-explore-dropdown-wrapper">
                <button type="button" class="btn btn-pill-solid hero-btn-primary" id="explore-articles-btn" onclick="toggleHeroThemes(event)" aria-expanded="false">
                    <i class="fas fa-layer-group"></i>
                    {{ home.hero_button_text | default("Explore Articles") }}
                    <i class="fas fa-chevron-down hero-btn-chevron"></i>
                </button>
                <div class="hero-theme-dropdown" id="hero-theme-dropdown">
                    <div class="hero-theme-dropdown-header">
                        <span><i class="fas fa-layer-group"></i> Select a Theme:</span>
                    </div>
                    <div class="hero-theme-dropdown-list">
                        {% for key, cat in categories %}
                        <a href="/categories/{{ key }}/" class="hero-theme-drop-item">
                            <span class="drop-icon drop-icon--{{ cat.color_class }}"><i class="fas {{ cat.icon }}"></i></span>
                            <span>{{ cat.title }}</span>
                            <i class="fas fa-chevron-right hero-theme-drop-arrow"></i>
                        </a>
                        {% endfor %}
                        <a href="#articles" onclick="scrollToArticles(event)" class="hero-theme-drop-item hero-theme-drop-item--all">
                            <span class="drop-icon" style="background:rgba(212,175,55,0.2);color:var(--accent-gold);"><i class="fas fa-book-open"></i></span>
                            <span>Browse All on Page</span>
                            <i class="fas fa-arrow-down hero-theme-drop-arrow"></i>
                        </a>
                    </div>
                </div>
            </div>
            <a href="#about" class="btn hero-btn-ghost">
                <i class="fas fa-info-circle"></i>
                About the Journal
            </a>
        </div>

        <!-- Credibility stats bar -->
        <div class="hero-stats">
            <div class="hero-stat">
                <span class="hero-stat-value">{{ collections.posts | length }}</span>
                <span class="hero-stat-label">Publications</span>
            </div>
            <div class="hero-stat-divider"></div>
            <div class="hero-stat">
                <span class="hero-stat-value">⚖️</span>
                <span class="hero-stat-label">Peer Reviewed</span>
            </div>
            <div class="hero-stat-divider"></div>
            <div class="hero-stat">
                <span class="hero-stat-value">🌐</span>
                <span class="hero-stat-label">Open Access</span>
            </div>
        </div>
    </div>

    <div class="hero-scroll-indicator">
        <span></span>
    </div>
</section>

<!-- About the Journal Section -->
<section id="about" class="about-section fade-in"{% if about.background_image %} style="--about-bg-image: url('{{ about.background_image }}');"{% endif %}>
    <div class="about-inner">
        <div class="about-badge">
            {% if about.profile_photo %}
            <img src="{{ about.profile_photo }}" alt="{{ about.title }}" class="about-profile-img">
            {% else %}
            <i class="fas fa-balance-scale"></i>
            {% endif %}
        </div>
        <div class="about-text">
            <span class="section-tag">{{ about.section_tag }}</span>
            <h2>{{ about.title | replace("SecuLex", "Secu<span class='text-gold'>Lex</span>") | safe }}</h2>
            <p class="about-lead">{{ about.lead_text }}</p>
            <p>{{ about.body_text }}</p>
            <div class="about-pillars">
                {% for pillar in about.pillars %}
                <div class="pillar">
                    <span class="pillar-emoji">{{ pillar.emoji }}</span>
                    <span>{{ pillar.text }}</span>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>

<main id="articles">
    <div class="section-header fade-in">
        <div class="section-header-badge">
            <i class="fas fa-scroll"></i>
            {{ home.publications_tag }}
        </div>
        <h2>{{ home.publications_title }}</h2>
        <p>{{ home.publications_description }}</p>
        <div class="section-header-line"></div>
    </div>

    <!-- Interactive Theme Filter Tabs for Articles -->
    <div class="theme-filter-tabs fade-in" id="theme-filter-tabs">
        <button type="button" class="theme-filter-tab active" data-filter="all">
            <i class="fas fa-globe"></i> All Themes
        </button>
        {% for key, cat in categories %}
        <button type="button" class="theme-filter-tab" data-filter="{{ cat.title }}">
            <i class="fas {{ cat.icon }}"></i> {{ cat.title }}
        </button>
        {% endfor %}
    </div>

    <div class="blog-grid fade-in" id="home-articles-grid">
        {% set all_posts = collections.posts | reverse %}
        {% for post in all_posts %}
        <article class="blog-card" data-category="{{ post.data.category }}">
            <div class="card-img">
                <a href="{{ post.url }}">
                    <img src="{{ post.data.thumbnail }}" alt="{{ post.data.title }}" loading="lazy">
                    <div class="card-overlay">
                        <span><i class="fas fa-book-open" style="margin-right:0.4rem;"></i>{{ articles_page.read_label | default("Read Analysis") }}</span>
                    </div>
                </a>
                <span class="card-category-badge">{{ post.data.category }}</span>
            </div>
            <div class="card-content">
                <div class="meta">
                    <span class="date"><i class="far fa-calendar-alt" style="margin-right:0.3rem;opacity:0.6;"></i>{{ post.data.date | readableDate }}</span>
                    {% if post.data.read_time %}<span class="read-time"><i class="far fa-clock"></i> {{ post.data.read_time }} {{ articles_page.min_read_label | default("min read") }}</span>{% endif %}
                </div>
                <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
                <p>{{ post.data.description | truncate(130) }}</p>
                <div class="card-footer">
                    <a href="{{ post.url }}" class="read-more">{{ articles_page.read_label | default("Read Analysis") }} <i class="fas fa-arrow-right"></i></a>
                    {% if post.data.paywall_enabled %}<span class="card-paid-badge"><i class="fas fa-lock"></i> Premium</span>{% else %}<span class="card-free-badge"><i class="fas fa-unlock"></i> Open</span>{% endif %}
                </div>
            </div>
        </article>
        {% endfor %}
    </div>

    <div class="view-all-container fade-in">
        <a href="/articles/" class="btn-view-all">
            <i class="fas fa-layer-group"></i>
            {{ home.view_all_label | default("View All Publications") }}
            <i class="fas fa-arrow-right btn-view-all-arrow"></i>
        </a>
    </div>
</main>

<script>
function toggleHeroThemes(e) {
    if (e) {
        e.preventDefault();
        e.stopPropagation();
    }
    const menu = document.getElementById('hero-theme-dropdown');
    const btn = document.getElementById('explore-articles-btn');
    if (menu) {
        menu.classList.toggle('open');
        const isOpen = menu.classList.contains('open');
        if (btn) btn.setAttribute('aria-expanded', String(isOpen));
    }
}

function scrollToArticles(e) {
    if (e) e.preventDefault();
    const menu = document.getElementById('hero-theme-dropdown');
    if (menu) menu.classList.remove('open');
    const target = document.getElementById('articles');
    if (target) {
        target.scrollIntoView({ behavior: 'smooth' });
    }
}

document.addEventListener('click', function(e) {
    const wrapper = document.querySelector('.hero-explore-dropdown-wrapper');
    if (wrapper && !wrapper.contains(e.target)) {
        const menu = document.getElementById('hero-theme-dropdown');
        if (menu) menu.classList.remove('open');
    }
});

// Live in-place filter tabs
document.addEventListener('DOMContentLoaded', function() {
    const tabs = document.querySelectorAll('.theme-filter-tab');
    const cards = document.querySelectorAll('#home-articles-grid .blog-card');
    
    tabs.forEach(tab => {
        tab.addEventListener('click', function() {
            tabs.forEach(t => t.classList.remove('active'));
            this.classList.add('active');
            
            const filter = this.getAttribute('data-filter');
            cards.forEach(card => {
                const category = card.getAttribute('data-category');
                if (filter === 'all' || category === filter) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        });
    });
});
</script>
