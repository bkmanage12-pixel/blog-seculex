---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ "/" | absoluteUrl(site.site_url) }}</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ "/articles/" | absoluteUrl(site.site_url) }}</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>{{ "/categories/" | absoluteUrl(site.site_url) }}</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  {%- for key, cat in categories %}
  <url>
    <loc>{{ ("/categories/" + key + "/") | absoluteUrl(site.site_url) }}</loc>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  {%- endfor %}
  {%- for post in collections.posts %}
  <url>
    <loc>{{ post.url | absoluteUrl(site.site_url) }}</loc>
    {%- if post.date %}
    <lastmod>{{ post.date.toISOString().slice(0, 10) }}</lastmod>
    {%- endif %}
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  {%- endfor %}
  <url>
    <loc>{{ "/legal/privacy/" | absoluteUrl(site.site_url) }}</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>{{ "/legal/terms/" | absoluteUrl(site.site_url) }}</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>{{ "/legal/academic-integrity/" | absoluteUrl(site.site_url) }}</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
